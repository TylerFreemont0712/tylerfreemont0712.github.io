# frozen_string_literal: true

# This repo is a website, not a theme gem. The `github-pages` gem pins the
# exact set of plugins and versions GitHub Pages runs, so a local build
# matches production.
#
#   bundle install
#   bundle exec jekyll serve

source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick", "~> 1.8"
